# Copy to .env and fill in. install.sh does this automatically (with
# randomly generated secrets) if .env does not exist yet.

# --- Registry image to pull -------------------------------------------------
GITHUB_OWNER=nagoloum
IMAGE_TAG=latest

# --- Database ----------------------------------------------------------------
DB_USER=portail
DB_PASSWORD=changeme-generate-a-real-secret
DB_NAME=portail

# --- Auth / crypto -------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRES_IN=8h
PUBLIC_JWT_EXPIRES_IN=45m
# Server-side secret mixed into every PIN hash (see backend/src/common/security/pin.util.ts)
PIN_PEPPER=changeme-generate-a-real-secret

# Base URL the frontend/public links are built from.
# Local install.sh: http://localhost:${APP_HTTP_PORT}
# Real deployment: https://<your-subdomain>
FRONTEND_PUBLIC_BASE_URL=http://localhost:8080

# --- Object storage (MinIO, S3-compatible) --------------------------------
MINIO_ROOT_USER=portail
MINIO_ROOT_PASSWORD=changeme-generate-a-real-secret
S3_BUCKET=portail-pieces

# --- Uploads / links -----------------------------------------------------------
MAX_FILE_SIZE_MB=20
LINK_DEFAULT_TTL_DAYS=7
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# --- Demo lawyer account seeded on first boot -------------------------------
SEED_LAWYER_EMAIL=avocat@demo.dev
SEED_LAWYER_PASSWORD=Demo1234!
# Token of the seeded demo link only (install.sh prints it as a clickable
# client URL). Requests created through the API get a random token.
SEED_REQUEST_TOKEN=8f3a2c1b4d5e6f70

# --- Observability -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-generate-a-real-secret
GRAFANA_ROOT_URL=http://localhost:3001/

# --- Local host ports (127.0.0.1 only) --------------------------------------
APP_HTTP_PORT=8080
BACKEND_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001

# --- Real server deployment only (infra/docker-compose.edge.yml) -----------
# Uncomment and fill in when deploying behind the shared reverse proxy
# described in the README ("Routage"). Not used by ./install.sh.
#
# Note: /prometheus/ is protected by nginx basic auth on the edge, whose
# credential is NOT an env var - it is a bcrypt file created once by
# infra/nginx/generate-prometheus-htpasswd.sh. See README, "Etapes sur le
# serveur".
# DOMAIN=<you>.stage2-div.rayan-drissi.com
# CERTBOT_EMAIL=you@example.com
# LETSENCRYPT_STAGING=true
# EDGE_HTTP_PORT=<1st port of your assigned range>   # relayed from :80 by Host header
# EDGE_HTTPS_PORT=<2nd port of your assigned range>  # relayed from :443 by SNI
#
# The machine is SHARED. Every host port above AND in the "Local host ports"
# section must be moved inside your assigned range before deploying: those
# defaults (8080/3000/3001/9090/9093) are the ones every other candidate
# would also pick, and two containers cannot bind the same host port. Only
# the two EDGE_* ports are reachable from the internet; the rest stay on
# 127.0.0.1 for local debugging on the box (docker exec/ssh tunnel).
# Example with a range starting at 12000:
#   EDGE_HTTP_PORT=12000   EDGE_HTTPS_PORT=12001   APP_HTTP_PORT=12002
#   BACKEND_PORT=12003     PROMETHEUS_PORT=12004   ALERTMANAGER_PORT=12005
#   GRAFANA_PORT=12006
# and point the absolute-URL variables at the real domain:
#   FRONTEND_PUBLIC_BASE_URL=https://<you>.stage2-div.rayan-drissi.com
#   GRAFANA_ROOT_URL=https://<you>.stage2-div.rayan-drissi.com/grafana/
