# TLS-terminating edge, real production certs via certbot (see
# infra/certbot/init-letsencrypt.sh). ${DOMAIN} is envsubst'd by the
# official nginx image entrypoint at container start (see
# docker-compose.edge.yml). The `resolver` + variable-in-proxy_pass
# pattern forces nginx to resolve upstream container names at request
# time instead of config-load time, so a restart order race never
# crash-loops this container.
resolver 127.0.0.11 valid=10s;

server {
  listen 80;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  # Deposits are up to 20 Mo (see MAX_FILE_SIZE_MB) plus multipart overhead.
  client_max_body_size 25m;

  # Only this edge terminates TLS, so HSTS is declared here (the frontend
  # container answers plain HTTP on the docker network and must not).
  add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

  location / {
    set $upstream_frontend frontend;
    proxy_pass http://$upstream_frontend:80;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # Observability, reachable on the same domain+port since only two ports
  # in our range are actually internet-routed (see README "Routage").
  #
  # Access control differs between the two because their capabilities do:
  # Grafana has a real login of its own (GF_USERS_ALLOW_SIGN_UP=false, one
  # admin account) so it is proxied as-is; Prometheus has NO authentication
  # whatsoever, so nginx supplies it - see the /prometheus/ block.
  #
  # No trailing slash on proxy_pass: the prefix is NOT stripped. Grafana
  # runs with GF_SERVER_SERVE_FROM_SUB_PATH=true and a root_url ending in
  # /grafana/, so it expects to receive the prefix. Stripping it made
  # Grafana redirect / to its root_url on every request - an infinite 301
  # loop on /grafana/.
  location /grafana/ {
    set $upstream_grafana grafana;
    proxy_pass http://$upstream_grafana:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # Prometheus is the mirror image of Grafana. It keeps serving at the root
  # internally (--web.route-prefix=/, see docker-compose.edge.yml) so that
  # its own self-scrape of localhost:9090/metrics keeps working, and only
  # the links it generates carry the public prefix (--web.external-url).
  # The prefix must therefore be stripped here - and a URI on proxy_pass
  # does not strip anything when the upstream is a variable (nginx then
  # forwards the URI untouched), so the rewrite does it explicitly.
  location /prometheus/ {
    # Prometheus ships no authentication of its own: published like this it
    # answered /api/v1/query to anyone on the internet, which handed out the
    # deposit volumes and - worse - pin_verification_total{result="failure"},
    # letting an attacker watch their own brute-force attempt land in real
    # time. nginx is the only place left to put a credential, since the
    # shared front proxy routes a single hostname to us (see README
    # "Routage") and there is no second host to hide it behind.
    #
    # Grafana keeps scraping it over the docker network, not through here,
    # so its dashboards are unaffected.
    auth_basic "Prometheus";
    auth_basic_user_file /etc/nginx/prometheus.htpasswd;

    # `set` must come before `rewrite ... break`: both run in the rewrite
    # phase, and `break` ends it - a `set` placed after never executes, and
    # nginx then proxies to an empty host ("no host in upstream :9090").
    set $upstream_prometheus prometheus;
    rewrite ^/prometheus/(.*)$ /$1 break;
    proxy_pass http://$upstream_prometheus:9090;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
